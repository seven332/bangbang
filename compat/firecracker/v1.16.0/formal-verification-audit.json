      "id": "token-bucket-refill-accounting",
      "category": "rate-limit-accounting",
      "package": "bangbang-runtime",
      "source": "crates/runtime/src/token_bucket.rs",
      "harness": "token_bucket::verification::verify_token_bucket_refill_accounting",
      "command": [
        "cargo",
        "kani",
