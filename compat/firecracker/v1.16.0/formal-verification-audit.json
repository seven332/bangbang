      "id": "pager-limits-admission",
      "category": "capability-input-arithmetic",
      "package": "bangbang-pager",
      "source": "crates/pager/src/frame.rs",
      "harness": "frame::verification::verify_pager_limits_admission",
      "command": [
        "cargo",
        "kani",
        "--package",
        "bangbang-pager",
        "--lib",
        "--harness",
        "frame::verification::verify_pager_limits_admission",
        "--exact"
      ],
      "owner": "crates/pager/src/frame.rs::PagerLimits::new",
      "assumptions": [
        "No kani::assume constraints; the invariant applies to every successful constructor result over the Rust input types."
      ],
      "bounds": [
        "page_size, max_frame_bytes, and operation bits cover the full u32 domain; region_count and max_in_flight cover the full u16 domain."
      ],
      "invariant": "Every admitted pager limit set has a supported power-of-two page size, nonzero bounded counts, the exact v1 operation set, and a nonoverflowing frame bound large enough for one page but no larger than the protocol maximum.",
      "implementation": [
        {
          "kind": "local",
          "path": "crates/pager/src/frame.rs",
          "anchor": "fn verify_pager_limits_admission()"
        }
      ],
      "validation": [
        {
          "kind": "local",
          "path": "crates/pager/src/frame.rs",
          "anchor": "exact_global_edges_succeed_and_one_over_edges_fail"
        }
      ]
    },
