        "--lib",
        "--harness",
        "token_bucket::verification::verify_token_bucket_refill_accounting",
        "--exact",
        "--solver",
        "kissat"
      ],
      "owner": "crates/runtime/src/token_bucket.rs::token_bucket_refill",
      "assumptions": [
        "The current budget does not exceed the configured bucket size.",
        "The elapsed logical refill time does not exceed one complete refill interval."
      ],
      "bounds": [
        "1 <= size <= 4096, 1 <= refill_time_nanos <= 1000000000, budget <= size, and elapsed_nanos <= refill_time_nanos.",
        "Symbolic u16 size/budget and u32 refill/elapsed sources exactly cover those admitted intervals before widening to the production u64/u128 types."
      ],
      "invariant": "Refill classification is exact at zero-token and full-interval boundaries; a partial refill never decreases or overfills budget and consumes a positive logical duration smaller than the interval and no greater than elapsed time.",
      "implementation": [
        {
          "kind": "local",
          "path": "crates/runtime/src/token_bucket.rs",
          "anchor": "fn verify_token_bucket_refill_accounting()"
        }
