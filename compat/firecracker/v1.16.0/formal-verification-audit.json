      "owner": "crates/runtime/src/virtio_queue.rs::virtqueue geometry and EVENT_IDX",
      "assumptions": [
        "queue_size is a nonzero power of two, matching the production virtqueue admission contract."
      ],
      "bounds": [
        "queue_size, descriptor index, and EVENT_IDX values otherwise cover the full u16 domain; the ring base covers the full u64 domain."
      ],
      "invariant": "Descriptor, available, and used ring ranges have exact sizes and succeed exactly when their exclusive end does not overflow; descriptor index admission is exact, an empty used interval never notifies, and the next used entry notifies its matching event.",
      "implementation": [
        {
          "kind": "local",
